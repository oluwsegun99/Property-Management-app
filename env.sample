# ==============================================
# PROPERTY MANAGEMENT APPLICATION
# Environment Configuration Template
# ==============================================

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
# Application port (default: 3000)
PORT=3000

# Environment mode (development, production, test)
NODE_ENV=development

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://propertymanagement:password@localhost:5433/propertymanagementDb"

# ==============================================
# JWT AUTHENTICATION
# ==============================================
# Access token secret key (use a strong random string)
ACCESS_SECRET="your-secure-access-token-secret-here"

# Refresh token secret key (use a different strong random string)
REFRESH_SECRET="your-secure-refresh-token-secret-here"

# ==============================================
# TWO-FACTOR AUTHENTICATION
# ==============================================
# Authenticator secret for 2FA (use a strong random string)
AUTHENTICATOR_SECRET="your-secure-authenticator-secret-here"

# ==============================================
# TYPESENSE SEARCH ENGINE
# ==============================================
# Typesense server host
TYPESENSE_HOST="localhost"

# Typesense server port
TYPESENSE_PORT="8108"

# Typesense protocol (http or https)
TYPESENSE_PROTOCOL="http"

# Typesense API key (admin key with full access)
TYPESENSE_ADMIN_API_KEY="your-typesense-admin-api-key-here"

# ==============================================
# NOTES
# ==============================================
# 1. Copy this file to .env and update with your actual values
# 2. Never commit the .env file to version control
# 3. Use strong, randomly generated secrets for production
# 4. Update database credentials to match your setup
# 5. For production, use HTTPS protocol for Typesense

